{
  "id": "neodex.pendu",
  "name": "Pendu",
  "version": "1.3.0",
  "author": "NDesumeur",
  "description": "Le jeu du pendu avec des mots français : 17 thèmes ou tous mélangés, lettres au clic ou au clavier, accents ignorés (E trouve aussi É, È, Ê). Quatre niveaux, de 10 erreurs avec la première et la dernière lettre données jusqu'à 4 erreurs sur des mots longs ; indice contre une erreur, mot dévoilé en cas d'échec, séries de victoires gardées. Tout le jeu en pixel art (potence, mot en cases, clavier dessiné), plein écran et jeu à la taille de l'écran.",
  "icon": "icon.png",
  "entry": "index.js",
  "view": "pendu",
  "neobase": ">=4.0.0",
  "type": "app",
  "category": "Jeux",
  "compatibility": [
    "windows",
    "linux"
  ],
  "syncMode": "aucune",
  "syncInfo": "Rien n'est synchronisé : tes records restent sur cet appareil.",
  "mobile": false,
  "system": false,
  "dependencies": {},
  "sdk": "2.1.0",
  "permissions": [
    "storage"
  ],
  "succes": [
    {
      "id": "premier",
      "nom": "Sauvé de justesse",
      "texte": "Trouver un premier mot"
    },
    {
      "id": "dix",
      "nom": "Vocabulaire",
      "texte": "Trouver 10 mots"
    },
    {
      "id": "cent",
      "nom": "Dictionnaire vivant",
      "texte": "Trouver 100 mots"
    },
    {
      "id": "serie5",
      "nom": "Sur la lancée",
      "texte": "Trouver 5 mots de suite"
    },
    {
      "id": "serie15",
      "nom": "Increvable",
      "texte": "Trouver 15 mots de suite"
    },
    {
      "id": "parfait",
      "nom": "Sans une faute",
      "texte": "Trouver un mot sans aucune erreur"
    },
    {
      "id": "difficile",
      "nom": "Mots savants",
      "texte": "Trouver un mot en Difficile"
    },
    {
      "id": "expert",
      "nom": "Corde raide",
      "texte": "Trouver un mot en Expert"
    },
    {
      "id": "fil",
      "nom": "Au fil du rasoir",
      "texte": "Trouver un mot avec une seule erreur restante",
      "cache": true
    }
  ],
  "records": [
    {
      "id": "serie",
      "nom": "Plus longue série",
      "sens": "haut",
      "format": "nombre",
      "unite": "mots"
    },
    {
      "id": "trouves",
      "nom": "Mots trouvés",
      "sens": "haut",
      "format": "nombre"
    }
  ]
}
